package-as: TwinkTracker
manual-changelog: CHANGELOG.md

ignore:
  - .git
  - .github
  - .release
  - .env
  - .env.*
  - AGENTS.md
  - COMPATIBILITY.md
  - CURSEFORGE_DESCRIPTION.md
  - DATA_SOURCES.md
  - README.md
  - tests
  - tools
  - tmp
  - .gitignore
  - .pkgmeta
  - assets/logo.png
  - assets/minimap-icon-source.png
  - assets/logo1-1.png
  - assets/twinkortreat.webp
  - "*.code-workspace"
